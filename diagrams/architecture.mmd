        IAMCenter[IAM Identity Center]
        MFA[MFA Service]
    end

    subgraph Access["Access Layer"]
        VerifiedAccess[AWS Verified Access]
        Policies[Access Policies]
        Context[Context Engine]
    end

    subgraph Network["Network Layer"]
        Firewall[Network Firewall]
        PrivateLink[PrivateLink Endpoints]
        SecurityGroups[Security Groups]
    end

    subgraph Workloads["Protected Workloads"]
        App1[Application A]
        App2[Application B]
        Data[Data Store]
    end

    subgraph Monitoring["Security Monitoring"]
        CloudTrail[CloudTrail]
        GuardDuty[GuardDuty]
        SecurityHub[Security Hub]
    end

    Employee --> IdP
    Contractor --> IdP
    Device --> Context
    IdP --> IAMCenter
    IAMCenter --> MFA
    MFA --> VerifiedAccess
    Context --> VerifiedAccess
    VerifiedAccess --> Policies
    Policies --> Firewall
    Firewall --> PrivateLink
    PrivateLink --> SecurityGroups
